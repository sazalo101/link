// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  links     Link[]
  profile   Profile?
  safariCategories SafariCategory[]
  activities Activity[]
  socialLinks SocialLink[]
}

model Link {
  id        String   @id @default(cuid())
  title     String
  url       String
  order     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  linkType  String   @default("regular") // "regular", "safari", "activity", "social"
}

model Profile {
  id          String  @id @default(cuid())
  title       String?
  description String?
  theme       String  @default("default")
  profileImageUrl String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String  @unique
}

model SafariCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  packages    SafariPackage[]
}

model SafariPackage {
  id               String   @id @default(cuid())
  name             String
  description      String?
  price            String?
  duration         String?
  imageUrl         String?
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  safariCategory   SafariCategory @relation(fields: [safariCategoryId], references: [id], onDelete: Cascade)
  safariCategoryId String
  packageImages    PackageImage[]
}

model PackageImage {
  id              String        @id @default(cuid())
  imageUrl        String
  caption         String?
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  safariPackage   SafariPackage @relation(fields: [safariPackageId], references: [id], onDelete: Cascade)
  safariPackageId String
}

model Activity {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}
